<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      TextToSpeech binds to an engine that lives in another app. Since Android 11,
      package visibility filtering hides it unless it is declared here - and the
      failure is silent: the engine is simply never found, so init never succeeds
      and the app says nothing.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
