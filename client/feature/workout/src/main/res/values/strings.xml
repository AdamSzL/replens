<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="exercise_picker_title">Workout</string>
    <string name="exercise_squat">Squat</string>

    <!-- Permanent disclosure, so the camera is explained before it is asked for
         rather than in a screen the user has to dismiss. -->
    <string name="exercise_picker_camera_disclosure">RepLens watches your form with the camera. Video never leaves your phone.</string>

    <!-- Shown when the system will no longer offer its own dialog, which is the
         one case the app has to explain something the system will not. -->
    <string name="exercise_picker_camera_blocked_title">Camera access is off</string>
    <string name="exercise_picker_camera_blocked_message">RepLens needs the camera to count your reps and check your form. Turn it on in Settings to start a workout.</string>
    <string name="exercise_picker_camera_blocked_confirm">Open settings</string>
    <string name="exercise_picker_camera_blocked_dismiss">Not now</string>

    <string name="workout_flip_camera">Switch camera</string>
    <string name="workout_start_set">Start set</string>
    <string name="workout_setup_no_pose">Step into frame</string>
    <string name="workout_setup_too_close">Step back from the phone</string>
    <string name="workout_setup_legs_not_visible">Step back so your feet are in frame</string>
    <string name="workout_setup_hold_still">Hold still</string>
    <string name="workout_cancel">Cancel</string>
    <string name="workout_finish">Finish</string>
    <string name="workout_done">Done</string>
    <string name="workout_go_again">Go again</string>
    <string name="workout_reps_squat">reps · squat</string>
    <string name="workout_reps_at_depth">%1$d of %2$d at depth</string>

    <!-- Spoken only. The screen shows the same countdown as a numeral; this exists
         so the digit is formatted by the locale the voice is speaking. -->
    <string name="workout_cue_count_in">%1$d</string>
    <string name="workout_cue_go">Go</string>
    <!-- Spoken only, and deliberately its own resource rather than a reuse of the
         count-in despite the identical text: UiText.Resource equality includes the
         id, so one shared resource would make the countdown's "1" and the first rep
         the same cue, which the announcer treats as already said. Bare numeral
         because a coach counts "one, two, three", and because it has to fit in the
         gap between two reps. -->
    <string name="workout_cue_rep">%1$d</string>
    <!-- Spoken only, and both kept short because they land at rep completion and
         have to fit in the gap before the next rep. "Go deeper" replaces the rep
         number rather than following it: "eight, go deeper" is roughly three times
         as long and the gap is not that big. -->
    <string name="workout_cue_go_deeper">Go deeper</string>
    <!-- Says what happened rather than what to do, because nothing counted and
         "go deeper" would imply something did. -->
    <string name="workout_cue_all_the_way_down">All the way down</string>
    <!-- Spoken at the end of a set. Redundant today, since the only way to finish
         is to walk over and press the button, and the card is then right there.
         It earns its place when a set can end without a press - a rep target, or
         a long enough pause - and is here now because it costs nothing to say.
         Both numbers, since the headline count alone is deliberately lenient and
         says nothing about whether the reps were any good. -->
    <plurals name="workout_cue_set_summary">
        <item quantity="one">%1$d rep, %2$d at depth</item>
        <item quantity="other">%1$d reps, %2$d at depth</item>
    </plurals>
</resources>
